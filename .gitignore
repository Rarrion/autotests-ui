# Виртуальное окружение
.venv/
venv/
env/
ENV/

# Кеш и артефакты Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/

# Настройки IDE
.idea/
.vscode/
*.iml

# Артефакты тестов
.pytest_cache/
allure-results/
allure-report/
tracing/
videos/
playwright-report/
test-results/
*.log
# Генерируемые при запуске файлы: browser-state.json, html-отчеты и т.п.
*.html
*.json

# Покрытие UI (ui-coverage-tool): HTML/JSON-отчеты, история и промежуточные результаты
coverage.html
coverage-results/
coverage-report.json
coverage-history.json

# Секреты и локальные настройки
# .env намеренно не игнорируется: он нужен для запуска автотестов на CI
# (GitHub Actions, GitLab CI) и не содержит секретов - только учебные настройки
.env.local

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini

# Токены и ключи - никогда не коммитить
Token.txt
token.txt
*token*.txt
*.pem
*.key
credentials*
